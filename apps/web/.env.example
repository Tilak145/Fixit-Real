# Copy this file to .env.local for your own computer, and enter the same names
# in your host's settings (Vercel: Project > Settings > Environment Variables).
# Never commit real values.

# Supabase > Project Settings > API. The anon key is public by design; the
# service_role key must never go here or anywhere in the website.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The site's public address, for example https://www.yourdomain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
