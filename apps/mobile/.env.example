# Copy this file to .env and fill it in. Public values only: the Supabase address,
# its public (anon) key and the website. Never put a service-role key or a Stripe
# key here; those stay inside Supabase.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key
EXPO_PUBLIC_SITE_URL=https://www.fixitls.com
EXPO_PUBLIC_APP_SCHEME=fixit
